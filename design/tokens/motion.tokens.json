{
  "$description": "Motion tokens. Springs use Apple's response/damping-fraction model and are converted per platform.",
  "motion": {
    "spring": {
      "navigate": {
        "$description": "Screen pushes. SwiftUI .spring(response:dampingFraction:); Compose spring(dampingRatio, stiffness = (2\u03c0/response)\u00b2).",
        "response": {
          "$type": "number",
          "$value": 0.35
        },
        "dampingFraction": {
          "$type": "number",
          "$value": 1.0
        }
      },
      "panel": {
        "$description": "Panels rising and following a drag. SwiftUI .spring(response:dampingFraction:); Compose spring(dampingRatio, stiffness = (2\u03c0/response)\u00b2).",
        "response": {
          "$type": "number",
          "$value": 0.42
        },
        "dampingFraction": {
          "$type": "number",
          "$value": 0.9
        }
      },
      "press": {
        "$description": "Ring and button release. SwiftUI .spring(response:dampingFraction:); Compose spring(dampingRatio, stiffness = (2\u03c0/response)\u00b2).",
        "response": {
          "$type": "number",
          "$value": 0.3
        },
        "dampingFraction": {
          "$type": "number",
          "$value": 0.7
        }
      },
      "drop": {
        "$description": "Captured photo dropping into the last-shot well. SwiftUI .spring(response:dampingFraction:); Compose spring(dampingRatio, stiffness = (2\u03c0/response)\u00b2).",
        "response": {
          "$type": "number",
          "$value": 0.42
        },
        "dampingFraction": {
          "$type": "number",
          "$value": 0.86
        }
      }
    },
    "pressScale": {
      "ring": {
        "$type": "number",
        "$value": 0.92
      },
      "button": {
        "$type": "number",
        "$value": 0.97
      }
    },
    "pressDown": {
      "$type": "duration",
      "$value": {
        "value": 100,
        "unit": "ms"
      }
    },
    "dip": {
      "peak": {
        "$type": "number",
        "$value": 0.6,
        "$description": "Black overlay peak opacity on capture."
      },
      "duration": {
        "$type": "duration",
        "$value": {
          "value": 140,
          "unit": "ms"
        }
      }
    },
    "develop": {
      "blur": {
        "$type": "dimension",
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "saturation": {
        "$type": "number",
        "$value": 0.2
      },
      "duration": {
        "$type": "duration",
        "$value": {
          "value": 600,
          "unit": "ms"
        }
      },
      "easing": {
        "$type": "cubicBezier",
        "$value": [0.22, 1, 0.36, 1]
      }
    },
    "pulse": {
      "scale": {
        "$type": "number",
        "$value": 1.06
      },
      "duration": {
        "$type": "duration",
        "$value": {
          "value": 240,
          "unit": "ms"
        }
      }
    },
    "live": {
      "min": {
        "$type": "number",
        "$value": 0.35
      },
      "period": {
        "$type": "duration",
        "$value": {
          "value": 1600,
          "unit": "ms"
        }
      }
    },
    "fade": {
      "$type": "duration",
      "$value": {
        "value": 200,
        "unit": "ms"
      }
    }
  }
}
